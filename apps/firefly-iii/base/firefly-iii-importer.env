APP_ENV=production
APP_DEBUG=false
TZ=UTC
# Server-to-server URL: the in-cluster Service (port 80).
FIREFLY_III_URL=http://firefly-iii
# Browser-facing URL (links/redirects back to Firefly III).
VANITY_URL=https://firefly-iii.${BASE_DOMAIN:=libre.pod}
TRUSTED_PROXIES=**
EXPECT_SECURE_URL=false
# FIREFLY_III_ACCESS_TOKEN is intentionally unset: a PAT can only be created
# after first login, and settings cannot be edited post-install. The importer's
# web UI prompts for it on first use.
