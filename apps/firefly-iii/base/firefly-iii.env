APP_ENV=production
APP_DEBUG=false
TZ=UTC
APP_URL=https://firefly-iii.${BASE_DOMAIN:=libre.pod}
TRUSTED_PROXIES=**
DB_CONNECTION=pgsql
DB_HOST=firefly-iii-postgres
DB_PORT=5432
DB_DATABASE=firefly
DB_USERNAME=firefly
# Header SSO: oauth2-proxy (after Casdoor auth) injects X-Auth-Request-Email,
# which Traefik's ForwardAuth middleware forwards. Firefly's remote_user_guard
# trusts it (proxy is fully trusted — the header only arrives on authenticated
# requests), auto-creating unknown users; the first one becomes owner.
# PHP spellings: X-Auth-Request-Email -> HTTP_X_AUTH_REQUEST_EMAIL.
AUTHENTICATION_GUARD=remote_user_guard
AUTHENTICATION_GUARD_HEADER=HTTP_X_AUTH_REQUEST_EMAIL
