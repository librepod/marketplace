# Step CA bootstrap configuration
STEPISSUER_NAMESPACE=step-ca

# Path in PVC (Step CA home directory)
STEPPATH=/home/step

# JWK provisioner whose kid lands in the provisioner-password Secret
PROVISIONER_NAME=default-jwk

# openbao API address for the CA publication step in job.sh (publish_ca)
OPENBAO_ADDR=http://openbao.openbao.svc.cluster.local:8200

# Platform wildcard TLS secret. cert-manager issues it into THIS namespace
# (traefik reads it from here via providers.kubernetesCRD.
# defaultTLSResourcesNamespace), so the CA-rotation heal in job.sh can force
# a re-issue with same-namespace RBAC only — cert-manager otherwise keeps
# the old-CA-signed cert until expiry.
WILDCARD_TLS_SECRET=tls-traefik-default-cert
