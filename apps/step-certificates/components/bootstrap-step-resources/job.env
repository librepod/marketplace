# Step CA bootstrap configuration
STEPISSUER_NAMESPACE=step-ca

# Path in PVC (Step CA home directory)
STEPPATH=/home/step

# JWK provisioner whose kid lands in the provisioner-password Secret
PROVISIONER_NAME=default-jwk

# openbao API address for the CA publication step in job.sh (publish_ca)
OPENBAO_ADDR=http://openbao.openbao.svc.cluster.local:8200
