CA_URL=https://step-certificates.step-ca.svc.cluster.local
CA_NAME=LibrePod
CA_DNS_1=127.0.0.1
CA_DNS_2=ca.${BASE_DOMAIN:=libre.pod}
CA_DNS_3=step-certificates.step-ca
CA_DNS_4=step-certificates.step-ca.svc.cluster.local
CA_ADDRESS=0.0.0.0:9000
CA_DEFAULT_PROVISIONER=default-jwk
CA_DEFAULT_TLS_DURATION=2160h
CA_MAX_TLS_DURATION=2160h
# openbao API for the restore-from-backup step in step-ca-init.sh
OPENBAO_ADDR=http://openbao.openbao.svc.cluster.local:8200
