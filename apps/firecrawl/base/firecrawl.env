# Firecrawl API/harness env — mirrors upstream docker-compose.yaml (v2.11.162).
# Secrets ride the firecrawl-settings Secret: POSTGRES_PASSWORD (key
# DB_PASSWORD) via secretKeyRef, OPENAI_API_KEY and custom variables via envFrom.
HOST=0.0.0.0
PORT=3002
EXTRACT_WORKER_PORT=3004
WORKER_PORT=3005
ENV=local
REDIS_URL=redis://valkey:6379
REDIS_RATE_LIMIT_URL=redis://valkey:6379
PLAYWRIGHT_MICROSERVICE_URL=http://playwright-service:3000/scrape
POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_HOST=nuq-postgres
POSTGRES_PORT=5432
USE_DB_AUTHENTICATION=false
NUM_WORKERS_PER_QUEUE=8
CRAWL_CONCURRENT_REQUESTS=10
MAX_CONCURRENT_JOBS=5
BROWSER_POOL_SIZE=5
NUQ_RABBITMQ_URL=amqp://rabbitmq:5672
HARNESS_STARTUP_TIMEOUT_MS=60000
