# Shared non-secret config for the bot and web-backend deployments
# (upstream .env.example defaults adapted for LibrePod). Install answers
# and generated secrets arrive via the remnawave-admin-settings Secret
# (OpenBao -> ESO) and are NEVER listed here.
POSTGRES_USER=remnawave
POSTGRES_DB=remnawave_bot
# Connection pool tuning (matches upstream docker-compose)
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=5
DEFAULT_LOCALE=en
# Bind all interfaces (k8s pod networking; upstream default is loopback-hostile)
WEB_HOST=0.0.0.0
WEB_BACKEND_PORT=8081
# Panel address as seen by the browser: CORS + email links + bot Mini App button
WEB_CORS_ORIGINS=https://remnawave-admin.${BASE_DOMAIN:=libre.pod}
APP_PUBLIC_URL=https://remnawave-admin.${BASE_DOMAIN:=libre.pod}
# Bot -> backend internal API uses the in-cluster Service name
# (upstream default http://web-backend:8081 is the compose container name)
INTERNAL_API_BACKEND_URL=http://remnawave-admin-web-backend:8081
# WEB_TRUSTED_PROXIES intentionally unset: empty = trust private/loopback ranges,
# which covers the in-cluster Traefik pod. The backend port is never published
# outside the cluster, so there is nothing to pin down.
# Static paths inside the images (upstream compose)
PYTHONPATH=/app
MAXMIND_CITY_DB=/app/geoip/GeoLite2-City.mmdb
MAXMIND_ASN_DB=/app/geoip/GeoLite2-ASN.mmdb
BACKUP_DIR=/app/backups
