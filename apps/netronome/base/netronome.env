NETRONOME__HOST=0.0.0.0
NETRONOME__DB_PATH=/data/netronome.db
NETRONOME__CHECK_FOR_UPDATES=false
NETRONOME__OIDC_ISSUER=https://id.${BASE_DOMAIN:=libre.pod}
NETRONOME__OIDC_REDIRECT_URL=https://netronome.${BASE_DOMAIN:=libre.pod}/api/auth/oidc/callback
SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
# Optional Tailscale (server joins a tailnet and auto-discovers agents).
# Off by default — unset in netronome-config means no Tailscale at all.
# To enable per cluster, set in the netronome-config secret (Flux
# postBuild.substituteFrom):
#   NETRONOME__TAILSCALE_ENABLED: '"true"'   # quotes are REQUIRED — see below
#   NETRONOME__TAILSCALE_AUTH_KEY: <tskey/hiskey>
# plus any knob below (METHOD, HOSTNAME, STATE_DIR, CONTROL_URL).
# Bare true/false in the secret break the Kustomization apply: Flux's
# whole-value substitution re-parses scalars, so an unquoted bool lands as a
# YAML boolean, which the API server rejects in ConfigMap data. The quotes
# are stripped again by YAML parsing — netronome receives plain "true".
# See https://netrono.me/monitoring/tailscale/
NETRONOME__TAILSCALE_ENABLED=${NETRONOME__TAILSCALE_ENABLED:=}
NETRONOME__TAILSCALE_METHOD=${NETRONOME__TAILSCALE_METHOD:=auto}
NETRONOME__TAILSCALE_HOSTNAME=${NETRONOME__TAILSCALE_HOSTNAME:=}
NETRONOME__TAILSCALE_STATE_DIR=${NETRONOME__TAILSCALE_STATE_DIR:=/data/tsnet}
NETRONOME__TAILSCALE_CONTROL_URL=${NETRONOME__TAILSCALE_CONTROL_URL:=}
