NETRONOME__HOST=0.0.0.0
NETRONOME__DB_PATH=/data/netronome.db
NETRONOME__CHECK_FOR_UPDATES=false
NETRONOME__OIDC_ISSUER=https://id.${BASE_DOMAIN:=libre.pod}
NETRONOME__OIDC_REDIRECT_URL=https://netronome.${BASE_DOMAIN:=libre.pod}/api/auth/oidc/callback
SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
# Tailscale (server joins a tailnet and auto-discovers agents). Enabled here
# unconditionally: with method=auto and no auth key netronome falls back to
# host mode, logs a warning per discovery run and skips discovery — so an
# install is "tailnet-active" simply by setting NETRONOME__TAILSCALE_AUTH_KEY
# (plus any knob below) in the netronome-config secret (Flux
# postBuild.substituteFrom). Kept out of substitution on purpose: substituted
# bare true/false become YAML booleans, which the API server rejects in
# ConfigMap data. See https://netrono.me/monitoring/tailscale/
NETRONOME__TAILSCALE_ENABLED=true
NETRONOME__TAILSCALE_METHOD=${NETRONOME__TAILSCALE_METHOD:=auto}
NETRONOME__TAILSCALE_HOSTNAME=${NETRONOME__TAILSCALE_HOSTNAME:=}
NETRONOME__TAILSCALE_STATE_DIR=${NETRONOME__TAILSCALE_STATE_DIR:=/data/tsnet}
NETRONOME__TAILSCALE_CONTROL_URL=${NETRONOME__TAILSCALE_CONTROL_URL:=}
