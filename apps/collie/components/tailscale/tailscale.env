# containerboot settings. TS_AUTHKEY and TS_EXTRA_ARGS (e.g. a Headscale
# --login-server) are install settings, read from the collie-settings Secret.
#
# The node's tailnet name; the secret's TS_HOSTNAME setting overrides it.
# The default lives here, not as the setting's default, so a cleared answer
# (stored as no key at all) still names the node collie-lead.
# Changing it on an existing node renames it on Tailscale, which breaks any
# MagicDNS address members joined at; Headscale keeps the first name.
TS_HOSTNAME=collie-lead
TS_USERSPACE=false
TS_ACCEPT_DNS=false
TS_STATE_DIR=/var/lib/tailscale
# Empty ON PURPOSE. In Kubernetes containerboot defaults to keeping the node
# identity in a kube Secret ("tailscale", or the name given here) — but a
# Secret dies with the namespace, so every reinstall enrolled a new node with
# a new tailnet IP and MagicDNS name, silently breaking the crew. Set
# explicitly to "" (containerboot honours an explicitly empty value; unsetting
# the variable would fall back to the "tailscale" Secret) so the identity is
# tailscaled.state in TS_STATE_DIR — on the collie-data PVC. The lead then
# keeps its tailnet address across restarts and reinstalls.
TS_KUBE_SECRET=
# Log in with TS_AUTHKEY only when the stored identity can't (first start, or
# the node was deleted on the control server); otherwise run `tailscale set`.
# The default re-runs `tailscale up --authkey` on every start, and Headscale
# 0.28 turns each re-login with a tags-only pre-auth key into a NEW node
# (collie-lead-<random>, new IP) even though the machine key is unchanged.
# TS_EXTRA_ARGS therefore only apply at that first login.
TS_AUTH_ONCE=true
# /healthz on TS_LOCAL_ADDR_PORT (default [::]:9002), the startup probe's target.
TS_ENABLE_HEALTH_CHECK=true
# tailscaled-level opt-out of streaming client logs to log.tailscale.com
# (also opts out of support). `tailscale up` rejects --no-logs-no-support,
# so this cannot go in TS_EXTRA_ARGS.
TS_NO_LOGS_NO_SUPPORT=true
