# Hermes home. Everything persistent — code checkout, PM tool store, sessions,
# skills, memory, config.yaml — lives under this path, i.e. on the data PVC.
HERMES_HOME=/opt/data
HOME=/opt/data
# Dashboard OIDC: bare issuer — hermes appends /.well-known/openid-configuration
# itself. Casdoor's discovery and iss claim are both https://id.<BASE_DOMAIN>.
HERMES_DASHBOARD_OIDC_ISSUER=https://id.${BASE_DOMAIN:=libre.pod}
