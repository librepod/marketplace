# Seafile environment variables
TIME_ZONE=Etc/UTC
SEAFILE_LOG_TO_STDOUT=true
SITE_ROOT=/
SEAFILE_SERVER_LETSENCRYPT=false
SEAFILE_SERVER_HOSTNAME=seafile.${BASE_DOMAIN:=libre.pod}
SEAFILE_SERVER_PROTOCOL=https
SEAFILE_MYSQL_DB_HOST=mysql
SEAFILE_MYSQL_DB_PORT=3306
SEAFILE_MYSQL_DB_USER=seafile
SEAFILE_MYSQL_DB_CCNET_DB_NAME=ccnet_db
SEAFILE_MYSQL_DB_SEAFILE_DB_NAME=seafile_db
SEAFILE_MYSQL_DB_SEAHUB_DB_NAME=seahub_db
DB_HOST=mysql
INIT_SEAFILE_ADMIN_EMAIL=admin@${BASE_DOMAIN:=libre.pod}
CACHE_PROVIDER=redis
REDIS_HOST=redis
REDIS_PORT=6379
ENABLE_NOTIFICATION_SERVER=false
ENABLE_SEADOC=true
ENABLE_SEAFILE_AI=false
MD_FILE_COUNT_LIMIT=100000
NON_ROOT=false
ENABLE_GO_FILESERVER=true
# Storage backend
SEAF_SERVER_STORAGE_TYPE=disk
# Trust the step-CA-signed *.librepod.dev certs for the server-side OAuth
# token/userinfo exchange. The merged CA bundle is mounted at this path by
# the merge-ca-bundle init container (see deployment.yaml). REQUESTS_CA_BUNDLE
# is needed in addition to SSL_CERT_FILE because Seafile's OAuth client uses
# Python `requests`, which honors REQUESTS_CA_BUNDLE, not SSL_CERT_FILE.
SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
