# WG-Easy Configuration (generic defaults)
#
# Environment-specific values are injected at deploy time by Flux
# postBuild.substitute (see metadata.yaml). INIT_HOST resolves from
# ${FRP_SERVER_ADDR}, the public FRP relay address WireGuard clients dial.

# WireGuard endpoint host baked into client configs (public FRP server)
INIT_HOST=${FRP_SERVER_ADDR}
TZ=${TZ:-UTC}

# v15 Unattended Setup (only used on first start)
INIT_ENABLED=true
INIT_USERNAME=admin
INIT_PORT=51820
INIT_DNS=10.43.0.10
INIT_IPV4_CIDR=10.6.0.0/24
INIT_IPV6_CIDR=

# v15 Optional Configuration
# INSECURE must be false behind Traefik TLS: in v15.4 it selects the OAuth
# redirect URI scheme (INSECURE=true would send redirect_uri=http://... which
# Casdoor rejects) and gates Secure session cookies. Raw-HTTP access to the
# UI is not a supported path — the app is reached via its IngressRoute.
INSECURE=false
DISABLE_IPV6=true

# --- SSO (v15.4+, PR wg-easy#2659) ---
# Credentials come from Secret/wg-easy-sso, provisioned at runtime by the
# casdoor-sso-controller from the SSOClient CR in the overlay. Until that
# secret exists the provider is silently skipped (wg-easy filters providers
# without clientId/secret), so the pod boots fine during first install.
# Bare server URL — wg-easy's openid-client appends /.well-known/openid-configuration.
OAUTH_PROVIDERS=oidc
OAUTH_OIDC_SERVER=https://id.${BASE_DOMAIN:=libre.pod}
OAUTH_OIDC_NAME=LibrePod SSO
# Auto-register grants admin rights to anyone who can complete the OIDC login;
# on LibrePod only members of the Casdoor "librepod" org can, i.e. the owner.
OAUTH_AUTO_REGISTER=true

# TLS trust for the private Step CA (root+intermediate merged by the
# init container from overlay deployment-ca-patch.yaml). Node ignores
# SSL_CERT_FILE, hence the NODE_EXTRA_CA_CERTS twin.
SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
