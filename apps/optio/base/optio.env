# Non-secret Optio configuration (LibrePod-tuned defaults). Secret values
# (DB_PASSWORD, REDIS_PASSWORD, OPTIO_ENCRYPTION_KEY, OIDC credentials,
# custom install vars) never live here — they arrive via the optio-settings
# and optio-sso Secrets. ${BASE_DOMAIN} is substituted by Flux postBuild.
#
# VERSION ANCHOR: OPTIO_AGENT_IMAGE / OPTIO_AGENT_IMAGE_TAG below pin the
# image of agent pods the API creates at RUNTIME (repo workspaces, workflows).
# Bump together with overlays/librepod images[].newTag and metadata.yaml
# spec.version — no renovate manager reaches this file.

# ── API/web (both containers read this via envFrom) ──
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info
OPTIO_RUNTIME=kubernetes
OPTIO_AUTH_DISABLED=false
# The externally-reachable origin (OAuth callbacks, links); same-origin
# ingress routing means one URL serves both web and api.
PUBLIC_URL=https://optio.${BASE_DOMAIN:=libre.pod}
# The web UI shares the API's pod and reaches it over localhost.
INTERNAL_API_URL=http://127.0.0.1:4000
OPTIO_API_INTERNAL_URL=http://optio-api:4000

# ── OIDC (Casdoor via casdoor-sso-controller; credentials via optio-sso) ──
# Bare issuer — Optio appends /.well-known/openid-configuration itself.
OIDC_ISSUER_URL=https://id.${BASE_DOMAIN:=libre.pod}
OIDC_DISPLAY_NAME=SSO

# ── Redis (bundled Valkey component) ──
REDIS_URL=redis://optio-redis:6379
REDIS_MODE=standalone
OPTIO_QUEUE_PREFIX=

# ── Agent pods (created at runtime by the API in this namespace) ──
OPTIO_AGENT_IMAGE=ghcr.io/jonwiggins/optio-agent-base:0.18.2
OPTIO_AGENT_IMAGE_PREFIX=ghcr.io/jonwiggins/optio-agent-
OPTIO_AGENT_IMAGE_TAG=0.18.2
OPTIO_IMAGE_PULL_POLICY=IfNotPresent
OPTIO_AGENT_SERVICE_ACCOUNT_NAME=optio-agent
OPTIO_STATEFULSET_ENABLED=true
OPTIO_ROOTLESS=false
OPTIO_TERMINATION_GRACE_PERIOD_SECONDS=300
OPTIO_REPO_INIT_TIMEOUT_MS=120000
# nfs-client explicitly: the cluster has NO default StorageClass, so an empty
# value would leave the dynamically created agent PVCs Pending forever.
OPTIO_HOME_PVC_STORAGE_CLASS=nfs-client
OPTIO_HOME_PVC_SIZE=10Gi
OPTIO_CACHE_ENABLED=true
OPTIO_CACHE_STORAGE_CLASS=nfs-client
OPTIO_CACHE_MAX_SIZE_PER_DIR_GI=100
OPTIO_CACHE_MAX_SIZE_TOTAL_GI=200
OPTIO_CACHE_DEFAULT_SIZE_GI=10
OPTIO_ENVOY_IMAGE=envoyproxy/envoy:v1.31-latest

# ── Misc ──
# Explicit empty: config-as-code disabled (an unset key would linger in older
# Secrets and keep a once-enabled directory on).
OPTIO_CONFIG_DIR=
OPTIO_POD_ENABLED=false
OPTIO_RATE_LIMIT_MAX=600
OPTIO_OUTBOUND_ALLOW_PRIVATE=false
OPTIO_OUTBOUND_ALLOWED_HOSTS=
# Node ignores SSL_CERT_FILE; this makes the API's HTTPS calls to the IdP
# trust the LibrePod root CA mounted by overlays/librepod's CA patch.
NODE_EXTRA_CA_CERTS=/mnt/root-ca/root_ca.crt
