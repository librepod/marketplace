# Public Firefly III URL — pre-seeds the bot's per-user settings (used for links in chat).
# Deviation from one-owner-per-variable: FIREFLY_URL is also asked at install (optional,
# no default) so users pointing at an external Firefly III can override it. An empty
# answer leaves the key unset in OpenBao, so this platform default (which needs
# ${BASE_DOMAIN} substitution and therefore cannot ride settings) still applies.
FIREFLY_URL=https://firefly-iii.${BASE_DOMAIN:=libre.pod}
# In-cluster Firefly III API, bypassing Traefik/TLS — the Kubernetes pattern documented
# in the upstream .example.env
FIREFLY_API_URL=http://firefly-iii.firefly-iii.svc.cluster.local/api
# pino log level (trace|debug|info|warn|error) — v3 replaced DEBUG with LOG_LEVEL
LOG_LEVEL=info
