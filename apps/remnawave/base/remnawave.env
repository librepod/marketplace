### APP ###
APP_PORT=3000
METRICS_PORT=3001

### API ###
API_INSTANCES=1

### DATABASE ###
# DB_PASSWORD is substituted by Flux postBuild from Secret/remnawave-config
# (marketplace-generated). Kept in the ConfigMap because Flux can't substitute
# inside a secretGenerator's base64 output — same pattern as litellm.
DATABASE_URL=postgresql://postgres:${DB_PASSWORD}@remnawave-postgres:5432/remnawave

### REDIS ###
REDIS_SOCKET=/var/run/valkey/valkey.sock

### SECRETS ###
# APP_SECRET is substituted by Flux postBuild from Secret/remnawave-config.
# Signs auth JWTs and API tokens (replaces the 2.x JWT_*_SECRET pair).
APP_SECRET=${APP_SECRET}

### DOMAINS ###
PANEL_DOMAIN=remnawave.${BASE_DOMAIN:=libre.pod}
# CORS origin for the panel web UI
FRONT_END_DOMAIN=remnawave.${BASE_DOMAIN:=libre.pod}
# Public subscription URL. Default: served by the panel itself (/api/sub).
# Override when the subscription page runs on a separate edge server:
# add SUB_PUBLIC_DOMAIN=subscription.example.com (bare domain, no scheme/path)
# to stringData in apps/remnawave/secret.yaml (user-apps repo) — Flux
# substituteFrom injects it and the ConfigMap hash change restarts the panel.
SUB_PUBLIC_DOMAIN=${SUB_PUBLIC_DOMAIN:=remnawave.${BASE_DOMAIN:=libre.pod}/api/sub}

### TELEGRAM NOTIFICATIONS ###
IS_TELEGRAM_NOTIFICATIONS_ENABLED=false

### PROMETHEUS ###
# Guards /metrics on the metrics port only (not exposed via the Service;
# /health on the same port is unauthenticated and used by probes)
METRICS_USER=admin
METRICS_PASS=admin

### WEBHOOK ###
WEBHOOK_ENABLED=false
