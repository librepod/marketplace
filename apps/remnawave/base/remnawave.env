### APP ###
APP_PORT=3000
METRICS_PORT=3001

### API ###
API_INSTANCES=1

### DATABASE ###
# DATABASE_URL is composed in base/deployment.yaml from DB_PASSWORD (Secret/
# remnawave-settings, synced by ESO from OpenBao) so the password never lands
# in this ConfigMap. APP_SECRET also comes from that Secret via envFrom.

### REDIS ###
REDIS_SOCKET=/var/run/valkey/valkey.sock

### DOMAINS ###
PANEL_DOMAIN=remnawave.${BASE_DOMAIN:=libre.pod}
# CORS origin for the panel web UI
FRONT_END_DOMAIN=remnawave.${BASE_DOMAIN:=libre.pod}
# Public subscription URL — served by the panel itself (/api/sub). To point it
# at a separate edge server, add SUB_PUBLIC_DOMAIN=subscription.example.com
# (bare domain, no scheme/path) as a key in the OpenBao apps/remnawave entry:
# it rides Secret/remnawave-settings (envFrom, last) and overrides this value.
SUB_PUBLIC_DOMAIN=remnawave.${BASE_DOMAIN:=libre.pod}/api/sub

### TELEGRAM NOTIFICATIONS ###
IS_TELEGRAM_NOTIFICATIONS_ENABLED=false

### PROMETHEUS ###
# Guards /metrics on the metrics port only (not exposed via the Service;
# /health on the same port is unauthenticated and used by probes)
METRICS_USER=admin
METRICS_PASS=admin

### WEBHOOK ###
WEBHOOK_ENABLED=false
