# Mirrors apps/tailscale (standalone) — same interface: hostname, raw flags;
# login server is passed inside TS_EXTRA_ARGS, not a dedicated var.
# Values are hardcoded defaults: they used to arrive as optional per-install
# params via the remnawave-config substituteFrom Secret (incl. TS_AUTHKEY),
# a channel the OpenBao settings migration removed — nothing provides these
# vars anymore. Per-install tailnet joins lost their injection path; use the
# standalone tailscale app for that. accept-dns stays off (containerboot
# defaults TS_ACCEPT_DNS=false when unset; the standalone app documents why it
# can't be set to a literal "false" — Flux substitutes bare booleans, which
# EnvVar.value rejects).
TS_HOSTNAME=remnawave-panel
TS_EXTRA_ARGS=--accept-dns=false

# Divergences from the standalone app, on purpose (kernel-TUN sidecar in the
# panel pod, docs/tailscale-sidecar.md):
# - TS_USERSPACE=false + /dev/net/tun: the panel must ORIGINATE traffic into
#   the tailnet; userspace netstack can only proxy inbound.
# - No TS_ROUTES: plain client, never advertise routes from the panel pod.
# - TS_KUBE_SECRET explicit (the standalone relies on the in-cluster default
#   name "tailscale"): explicit survives containerboot default flips, and the
#   Role pins resourceNames to exactly this secret.
TS_USERSPACE=false
TS_KUBE_SECRET=remnawave-tailscale-state
# Log in with TS_AUTHKEY only when the stored identity can't (first start, or
# the node was deleted on the control server); otherwise run `tailscale set`.
# The default re-runs `tailscale up --authkey` on every start, and Headscale
# 0.28 turns each re-login with a tags-only pre-auth key into a NEW node
# remnawave-panel-<random>, new IP) even though the machine key is unchanged.
# TS_EXTRA_ARGS therefore only apply at that first login.
TS_AUTH_ONCE=true
