POSTGRES_DB=remnawave
POSTGRES_USER=postgres
# DO NOT CHANGE DATABASE TIMEZONE. IT MUST BE UTC (upstream compose).
TZ=UTC
# POSTGRES_PASSWORD comes from Secret/remnawave-settings (key DB_PASSWORD) via
# a secretKeyRef in components/postgres/deployment.yaml — the env name differs
# from the key, so it cannot ride envFrom. Same value as the password embedded
# in DATABASE_URL in base/deployment.yaml. Never changes for an existing
# install: the NFS-backed data dir keeps its users (converge re-heals drift).
