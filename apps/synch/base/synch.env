# Must match exactly how clients reach the server (scheme included) — better-auth
# rejects requests whose Origin doesn't match this.
PUBLIC_URL=https://synch.${BASE_DOMAIN:=libre.pod}

# Label shown on the OIDC sign-in button.
OIDC_PROVIDER_NAME=LibrePod SSO

# Encrypted version-history retention in whole days (upstream default is 1).
VERSION_HISTORY_RETENTION_DAYS=30

# Trust bundle: the overlay's CA patch mounts the merged bundle over the
# system path. Node fetch ignores SSL_CERT_FILE — NODE_EXTRA_CA_CERTS is the
# one it honors (docs/sso-app-author-guide.md §4).
SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
