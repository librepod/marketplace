# Connection details shared by the immich-server (Helm chart) and the bundled
# postgres Deployment. Non-secret only: DB_PASSWORD is supplied by
# Secret/immich-settings (synced from OpenBao by ESO — see externalsecret.yaml)
# — as DB_PASSWORD via envFrom on immich-server, and as POSTGRES_PASSWORD via a
# secretKeyRef on the postgres + converge-db-password containers (env name
# differs from the key, so it cannot ride envFrom).

# --- immich-server → database ---
DB_HOSTNAME=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
DB_VECTOR_EXTENSION=vectorchord

# --- postgres bootstrap (POSTGRES_* are read by the postgres image on first init) ---
POSTGRES_USER=postgres
POSTGRES_DB=immich
POSTGRES_INITDB_ARGS=--data-checksums
