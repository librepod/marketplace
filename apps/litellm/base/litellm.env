# LiteLLM Configuration
#
# Secrets (LITELLM_MASTER_KEY, LITELLM_SALT_KEY, DB_PASSWORD) come from
# Secret/litellm-settings, which ESO syncs from OpenBao — see
# base/externalsecret.yaml. The master key is the bootstrap admin credential
# for the proxy API; the salt key encrypts provider keys in the DB; DATABASE_URL
# is composed from DB_PASSWORD in base/deployment.yaml so the password never
# lands in this ConfigMap. Litellm without a master key serves an OPEN API —
# the settings item is load-bearing, never make it optional.
LITELLM_LOG=INFO
STORE_MODEL_IN_DB=True

# Optional: Custom token directory
GITHUB_COPILOT_TOKEN_DIR=/root/.config/litellm/github_copilot
# Optional: Custom access token file name
GITHUB_COPILOT_ACCESS_TOKEN_FILE=access-token
# Optional: Custom API key file name
GITHUB_COPILOT_API_KEY_FILE=api-key.json

# HTTP_PROXY=http://localhost:8888
# HTTPS_PROXY=http://localhost:8888
# http_proxy=http://localhost:8888
# https_proxy=http://localhost:8888

# --- SSO (OIDC admin-UI login via casdoor-sso-controller) ---
GENERIC_AUTHORIZATION_ENDPOINT=https://id.${BASE_DOMAIN}/login/oauth/authorize
GENERIC_TOKEN_ENDPOINT=https://id.${BASE_DOMAIN}/api/login/oauth/access_token
GENERIC_USERINFO_ENDPOINT=https://id.${BASE_DOMAIN}/api/userinfo
PROXY_BASE_URL=https://litellm.${BASE_DOMAIN}

# --- Trust the LibrePod private CA for OIDC calls to id.${BASE_DOMAIN} ---
# The merged bundle (system CAs + LibrePod root/intermediate) is mounted at
# this path by the merge-ca-bundle init container. SSL_CERT_FILE covers
# Python ssl/httpx; REQUESTS_CA_BUNDLE covers the requests lib.
SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

# --- Reverse-proxy scheme trust (uvicorn) ---
# uvicorn's proxy-headers middleware only honors X-Forwarded-Proto from IPs in
# FORWARDED_ALLOW_IPS (default 127.0.0.1). Traefik terminates TLS and connects
# from a pod IP, so without this the /ui -> /ui/ 307 is built with an absolute
# http:// Location and the browser's plain-HTTP hop never completes. '*' is
# safe here: the Service is ClusterIP-only.
FORWARDED_ALLOW_IPS=*
