# LiteLLM Configuration
#
# FIXME: CHANGE THIS ONCE WE IMPLEMENT SSO
LITELLM_MASTER_KEY=sk-1234
# Secrets below are substituted by Flux postBuild from Secret/litellm-config
# (marketplace-generated). Kept in the ConfigMap because Flux can't substitute
# inside a secretGenerator's base64 output — same pattern as immich.
LITELLM_SALT_KEY=${LITELLM_SALT_KEY}
LITELLM_LOG=INFO
STORE_MODEL_IN_DB=True
DATABASE_URL=postgresql://llmproxy:${DB_PASSWORD}@postgres:5432/litellm

# Optional: Custom token directory
GITHUB_COPILOT_TOKEN_DIR=/root/.config/litellm/github_copilot
# Optional: Custom access token file name
GITHUB_COPILOT_ACCESS_TOKEN_FILE=access-token
# Optional: Custom API key file name
GITHUB_COPILOT_API_KEY_FILE=api-key.json

# HTTP_PROXY=http://localhost:8888
# HTTPS_PROXY=http://localhost:8888
# http_proxy=http://localhost:8888
# https_proxy=http://localhost:8888

# --- SSO (OIDC admin-UI login via casdoor-sso-controller) ---
GENERIC_AUTHORIZATION_ENDPOINT=https://id.${BASE_DOMAIN}/login/oauth/authorize
GENERIC_TOKEN_ENDPOINT=https://id.${BASE_DOMAIN}/api/login/oauth/access_token
GENERIC_USERINFO_ENDPOINT=https://id.${BASE_DOMAIN}/api/userinfo
PROXY_BASE_URL=https://litellm.${BASE_DOMAIN}

# --- Trust the LibrePod private CA for OIDC calls to id.${BASE_DOMAIN} ---
# The merged bundle (system CAs + LibrePod root/intermediate) is mounted at
# this path by the merge-ca-bundle init container. SSL_CERT_FILE covers
# Python ssl/httpx; REQUESTS_CA_BUNDLE covers the requests lib.
SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
