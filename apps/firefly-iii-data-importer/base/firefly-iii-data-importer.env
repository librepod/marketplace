APP_ENV=production
APP_DEBUG=false
TZ=UTC
# Server-to-server URL: the firefly-iii app's Service in its own namespace.
FIREFLY_III_URL=http://firefly-iii.firefly-iii.svc.cluster.local
# Browser-facing URL (links/redirects back to Firefly III).
VANITY_URL=https://firefly-iii.${BASE_DOMAIN:=libre.pod}
TRUSTED_PROXIES=**
EXPECT_SECURE_URL=false
# FIREFLY_III_ACCESS_TOKEN is intentionally unset here: it is a required
# install setting (see metadata.yaml) delivered via the
# firefly-iii-data-importer-settings Secret. The importer v2 web UI offers no
# PAT field — without the env var it only shows the OAuth client-ID flow,
# which 500s under Firefly III's remote_user_guard SSO.
