# Non-secret Renovate runtime config, loaded via envFrom (configMapRef: renovate).
# A literal here on purpose: the old ${LOG_LEVEL} Flux-substitute was a
# self-referential no-op that shipped the literal string, and the settings
# Secret (envFrom, last) can override this default per install. The two path
# values are static literals that pair the container with its volume mounts.
LOG_LEVEL=info
RENOVATE_CONFIG_FILE=/opt/renovate/config.json
RENOVATE_BASE_DIR=/tmp/renovate
