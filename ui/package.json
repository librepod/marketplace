{
  "name": "librepod-ui",
  "version": "0.5.3",
  "private": true,
  "workspaces": [
    "packages/server",
    "packages/client",
    "packages/shared",
    "packages/e2e"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=packages/server",
    "dev:client": "npm run dev --workspace=packages/client",
    "build": "npm run build --workspace=packages/server",
    "build:client": "npm run build --workspace=packages/client",
    "test": "npm run test --workspace=packages/server",
    "test:client": "npm run test --workspace=packages/client -- --run",
    "test:client:watch": "npm run test --workspace=packages/client",
    "test:e2e": "npm run test:e2e --workspace=packages/server",
    "test:e2e:ui": "npm run test:e2e:ui --workspace=packages/e2e",
    "test:e2e:ui:cluster": "npm run test:e2e:ui:cluster --workspace=packages/e2e"
  },
  "dependencies": {
    "@nestjs/serve-static": "^5.0.5"
  }
}
