{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  dependencyDashboard: true,
  ignorePaths: ["infrastructure/**"],
  automerge: false,
  // config:recommended defaults to prHourlyLimit: 2, which parks most updates
  // as "rate-limited" on the dashboard (security PRs consume the budget first).
  // 0 = unlimited: open every pending PR each run. Safe here because there is
  // no auto-merge — a human still reviews and merges each one.
  prHourlyLimit: 0,
  prConcurrentLimit: 0,
  kustomize: { managerFilePatterns: ["/apps/.*/overlays/.*/kustomization\\.ya?ml/"] },
  flux: { managerFilePatterns: ["/apps/.*/base/ocirepository\\.ya?ml/"] },
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/apps/.*/metadata\\.yaml/"],
      matchStrings: [
        // datasource + depName are required; registryUrl + extractVersion are
        // optional trailing fields (used by the classic-helm and github-releases
        // apps). Order after depName is fixed: [registryUrl] then [extractVersion].
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: registryUrl=(?<registryUrl>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?\\s+version:\\s*\"?(?<currentValue>[^\"\\s]+)\"?",
      ],
    },
  ],
  packageRules: [
    // --- Scope: only track apps/. Everything else (ui/ npm, .github/ actions,
    // go.mod) is disabled — the mission is app image/chart updates.
    // Re-enable those areas deliberately later if desired.
    { matchFileNames: ["**/*", "!apps/**"], enabled: false },

    // --- Pin vendored dependency images. A sidecar shipped by the app vendor
    // (e.g. postgres:16) is a compatibility contract, not something to chase —
    // bumping it can break the product. Only the app's OWN image should move.
    // (couchdb is intentionally NOT pinned: it IS the obsidian-livesync app.)
    {
      matchDatasources: ["docker"],
      matchPackageNames: [
        "postgres",
        "redis",
        "mariadb",
        "mysql",
        "memcached",
        "valkey",
        "minio/minio",
        "ghcr.io/immich-app/postgres",
      ],
      enabled: false,
    },

    // --- One grouped PR per app: the image/chart bump + the spec.version bump
    // land together, keyed by the app's directory (apps/<app>).
    { matchFileNames: ["apps/*/**"], groupName: "{{packageFileDir}}" },

    // --- Major bumps get the e2e label + their own PR.
    { matchUpdateTypes: ["major"], addLabels: ["renovate-e2e"] },
  ],
}
