grid-rows: 2

# Row 1 (release pipeline): cut → build → pub → relboot
# Row 2 (inputs / sink):    ops   checks  ghcr  flux
#
# One token per node = its trigger. Dashed edge = async chain
# (workflow_run / workflow_call). Dotted edge = polls GHCR.

title: |md
  # LibrePod Marketplace — CI map
|

# ── Row 2, col 1: inputs ─────────────────────────────────────────

ops: "Inputs & ops" {
  direction: down
  style.fill: "#2a3323"

  renovate: "renovate — cron\nopens dependency PRs" {
    style.font-size: 14
  }
  ghcr-cleanup: "ghcr-cleanup — cron\nweekly prune of bootstrap" {
    style.font-size: 14
  }
  ai-review: "ai-review — comment\nLLM review on @askserge" {
    style.font-size: 14
  }
}

# ── Row 2, col 2: PR lane ────────────────────────────────────────

checks: "PR checks" {
  direction: down
  style.fill: "#2a3323"

  validate-apps: "validate-apps — PR\nlint + render gates" {
    style.font-size: 14
  }
  ui-e2e: "ui-e2e — PR\nTier 1: hermetic" {
    style.font-size: 14
  }
  ui-e2e-cluster: "ui-e2e-cluster — nightly\nTier 2: k3d cluster" {
    style.font-size: 14
  }
}

# ── Row 1: the release pipeline ──────────────────────────────────

cut: "Release cut" {
  direction: down
  style.fill: "#3a2a23"

  release-marketplace-ui: "release-marketplace-ui — manual\nopens release PR; merge = release" {
    style.font-size: 14
  }
}

build: "Image builds" {
  direction: down
  style.fill: "#232a3a"

  publish-marketplace-ui: "publish-marketplace-ui — PR / merge\nui/ → Docker image" {
    style.font-size: 14
  }
  publish-casdoor-sso-controller: "publish-casdoor-sso-controller — PR / merge\ncontroller/ → Docker image" {
    style.font-size: 14
  }
}

pub: "OCI artifact publish" {
  direction: down
  style.fill: "#2a2335"

  publish-apps: "publish-apps — PR / merge\napps/ → marketplace/apps/*" {
    style.font-size: 14
  }
  publish-components: "publish-components — PR / merge\ncomponents/ → marketplace/components" {
    style.font-size: 14
  }
  publish-bootstrap: "publish-bootstrap — PR / merge\nclusters+infra → marketplace/bootstrap" {
    style.font-size: 14
  }
  publish-catalog: "publish-catalog — auto\nregenerates catalog → marketplace/catalog" {
    style.font-size: 14
  }
}

relboot: "Bootstrap cut" {
  direction: down
  style.fill: "#3a2a23"

  release-bootstrap: "release-bootstrap — called / manual\ncuts X.Y.Z + git tag" {
    style.font-size: 14
  }
}

# ── Row 2, col 3-4: sink ─────────────────────────────────────────

ghcr: "GHCR — ghcr.io/librepod\nall images + OCI artifacts,\ncosign-signed" {
  style.fill: "#332020"
  style.font-size: 14
}

flux: "Flux on clusters\nlibrepod · dev · k3d" {
  style.fill: "#332020"
  style.font-size: 14
}

# ── Edges ────────────────────────────────────────────────────────

ops.renovate -> checks: "its PRs run\nthe PR lane" {style.stroke-dash: 3}

# the release happy path
cut.release-marketplace-ui -> build: "1. release PR merged" {style.bold: true}
cut.release-marketplace-ui -> pub: "1. same merge bumps pins" {style.bold: true}

build -> pub.publish-apps: "2. publish-apps waits\nfor the image" {style.stroke-dash: 1}

pub.publish-apps -> pub.publish-catalog: "3. auto re-publish" {style.stroke-dash: 6; style.bold: true}
pub.publish-components -> pub.publish-catalog: "3. auto re-publish" {style.stroke-dash: 6}

pub.publish-bootstrap -> relboot.release-bootstrap: "auto-cuts X.Y.Z" {style.stroke-dash: 6}

build -> ghcr
pub -> ghcr
relboot.release-bootstrap -> ghcr: "tagged"
ops.ghcr-cleanup -> ghcr: "prunes"

ghcr -> flux: "4. reconcile" {style.bold: true}
